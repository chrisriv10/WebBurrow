{
  "manifest_version": 3,
  "name": "WebBurrow Companion",
  "version": "0.1.0",
  "description": "Send pages, selected tabs, and chosen bookmarks to your local WebBurrow.",
  "key": "",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "optional_permissions": ["tabs", "bookmarks"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Send to WebBurrow", "default_popup": "popup.html" }
}
